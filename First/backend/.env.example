# Copy this file to .env and fill the values. Do NOT commit your real .env file.
# Example backend environment variables for Swastha_Sampark

# MongoDB connection URI (include username/password if using Atlas)
# e.g. MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/yourdb
MONGO_URI=

# JWT secret used to sign auth tokens. Use a long random string in production.
JWT_SECRET=change_this_to_a_strong_secret

# OpenRouteService API key (used for route/directions). Optional.
ORS_API_KEY=

# Server port (optional)
PORT=8000
